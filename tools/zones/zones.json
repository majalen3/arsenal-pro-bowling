  "exceptions": [
    {
      "from": "js/cc/addball.js",
      "to": "js/cc/model.js",
      "rule": "layer",
      "reason": "addball.js calls modelLine/presetFor to show the 'model line' note for a ball being added. model.js is lane/physics logic that wraps the unchanged engine; moving it would change shipped files. Candidate to move into ENGINE-adjacent kernel later."
    },
    {
      "from": "js/hub.js",
      "to": "js/cc/status.js",
      "rule": "layer",
      "reason": "hub.js (event-log runtime) uses status.js (currentBag, status words) to keep the saved bag consistent when events arrive. status.js sits in BAG because it imports bag.js; the proper fix is a lower 'ball status' kernel. Behavior-neutral to leave."
    },
    {
      "from": "js/screens/export.js",
      "to": "js/screens/more.js",
      "rule": "layer",
      "reason": "export.js imports only the VERSION constant from the Me screen (to stamp exports). A shared version constant (e.g. in SHELL) would remove this; left alone to avoid touching shipped files."
    },
    {
